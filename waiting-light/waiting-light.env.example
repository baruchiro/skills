# Copy to ~/.claude/waiting-light.env and chmod 600.
# If this file is absent, every hook exits immediately and the plugin does nothing,
# so it is safe to install on a machine that cannot reach Home Assistant.

# Base URL of Home Assistant, no trailing slash.
HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA -> Profile -> Security -> Long-lived access tokens.
HA_TOKEN=

# The input_boolean this plugin drives. Everything visual (which light, what
# colour, which guards) lives in a Home Assistant automation triggered by it.
HA_ENTITY=input_boolean.claude_session_waiting
